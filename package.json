{
  "name": "makerspace-management-system",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "db:start": "npm --prefix backend run db:start",
    "db:stop": "npm --prefix backend run db:stop",
    "db:status": "npm --prefix backend run db:status",
    "db:reset": "npm --prefix backend run db:reset",
    "db:seed-users": "npm --prefix backend run db:seed-users",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:backend": "npm --prefix backend run test:backend"
  }
}
